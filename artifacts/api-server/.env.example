# Copy this file to .env in this same folder and fill in real values.

# Required — Postgres connection string
DATABASE_URL=postgresql://username:password@localhost:5432/spendshield

# Required — port the API server listens on
PORT=5000

# Required — used to sign login tokens, make this a long random string
SESSION_SECRET=change_this_to_something_random

# Optional
LOG_LEVEL=info
