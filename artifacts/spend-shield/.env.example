# Copy this file to .env in this same folder and fill in real values.

# Required — port the dev server runs on
PORT=5173

# Required — base path the app is served from (use / for local dev)
BASE_PATH=/

# Optional — where the api-server is running, only used during dev.
# Default is http://localhost:5000, matching artifacts/api-server/.env.example
# API_PROXY_TARGET=http://localhost:5000
